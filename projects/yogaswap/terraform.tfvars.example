# Projekt-Konfiguration
# Kopiere diese Datei zu terraform.tfvars und passe die Werte an.
#
# HINWEIS (#241): Seit der Umstellung auf OpenTofu-Workspaces leitet tofu die
# env-spezifischen Werte (project, Emails, CloudFront-Aliases, cert-ARN) aus dem
# aktiven Workspace ab (siehe env.tf und env.<workspace>.json).
# terraform.tfvars wird von tofu dafür NICHT mehr ausgewertet.
#
# Diese Datei wird derzeit nur noch von einigen Scripts gelesen, die den
# Projektnamen daraus beziehen (Bereinigung folgt in #245). Trage daher den
# Projektnamen deiner Zielumgebung ein – KEINEN generischen Demo-Namen, damit
# nichts mit prod kollidiert.

project = "<PROJECT_NAME>"

region = "eu-central-1"
