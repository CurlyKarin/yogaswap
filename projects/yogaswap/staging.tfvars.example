# Staging-Umgebung (#102)
#
# Diese Datei beschreibt die staging-Variante. Sie nutzt DIESELBE Terraform-
# Konfiguration wie prod (projects/yogaswap/*.tf), aber einen eigenen
# `project`-Wert -> komplett eigene AWS-Ressourcen (Tabellen, Lambdas,
# Cognito, Bucket "${project}-site"). Keine Datenvermischung mit prod/demo.
#
# Nutzung (eigener State pro Umgebung ueber OpenTofu-Workspaces):
#   cd projects/yogaswap
#   cp staging.tfvars.example staging.tfvars
#   tofu workspace new staging        # einmalig; danach: tofu workspace select staging
#   tofu apply -var-file=staging.tfvars
#
# WICHTIG: Immer den Workspace pruefen (tofu workspace show), bevor du applyst.
# Im "default"-Workspace liegt prod (app.yogaswap.de) - dort NICHT mit
# staging-Vars applyen, sonst wuerden prod-Ressourcen ersetzt.

project = "yogaswap-staging"

region = "eu-central-1"

# SES laeuft noch in der Sandbox (#80): nur verifizierte Adressen funktionieren.
# Fuer staging die bereits verifizierte Adresse wiederverwenden.
ses_source_email           = "yogaswap@example.com"
studio_notification_emails = "yogaswap@example.com"

# Custom-Domain (staging.yogaswap.de) erst aktivieren, wenn ein ACM-Zertifikat
# fuer staging.yogaswap.de in us-east-1 existiert (siehe #61).
# Bis dahin leer lassen -> CloudFront ist ueber die *.cloudfront.net-Default-URL
# erreichbar, das reicht fuer den ersten Smoke-Test.
cloudfront_aliases             = []
cloudfront_acm_certificate_arn = ""
