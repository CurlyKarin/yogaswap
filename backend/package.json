{
  "name": "yogaswap-backend",
  "version": "1.0.0",
  "description": "Serverless backend für YogaSwap Demo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "build-lambdas": "tsc --build src/lambdas/createSwap/tsconfig.json src/lambdas/deleteSwap/tsconfig.json src/lambdas/updateSwap/tsconfig.json src/lambdas/createOverride/tsconfig.json src/lambdas/updateOverride/tsconfig.json",
    "zip": "node scripts/zipLambdas.mjs",
    "build-and-zip": "npm run build-lambdas && npm run zip-lambdas",
    "seed": "ts-node src/seed/index.ts",
    "seed:build": "npm run build && node dist/seed/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.890.0",
    "@aws-sdk/client-lambda": "^3.388.0",
    "@aws-sdk/lib-dynamodb": "^3.388.0",
    "@yogaswap/shared": "file:../shared",
    "archiver": "^5.3.2",
    "aws-amplify": "^6.15.7",
    "aws-lambda": "^1.0.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.4.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  }
}
