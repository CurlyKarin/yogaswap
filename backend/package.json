    "@yogaswap/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
