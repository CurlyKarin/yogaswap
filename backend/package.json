{
  "name": "yogaswap-backend",
  "version": "1.0.0",
  "description": "Serverless backend für YogaSwap Demo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build && npm run build-lambdas",
    "build-lambdas": "node scripts/buildLambdas.mjs",
    "zip": "node scripts/zipLambdas.mjs",
    "build-and-zip": "npm run build-lambdas && npm run zip",
    "seed": "ts-node src/seed/index.ts",
    "seed:build": "npm run build && node dist/seed/index.js",
    "seed:tenants": "ts-node src/scripts/seed_tenants.ts",
    "create-tenant": "ts-node src/scripts/create_tenant.ts",
    "backfill:participants": "ts-node src/scripts/backfill_participant_profiles.ts",
    "backfill:course-uids": "ts-node src/scripts/backfill_course_uids.ts",
    "backfill:participant-ids": "tsx src/scripts/backfill_participant_ids.ts",
    "backfill:operational-nicknames": "tsx src/scripts/backfill_operational_nicknames.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.890.0",
    "@aws-sdk/client-lambda": "^3.388.0",
    "@aws-sdk/lib-dynamodb": "^3.388.0",
    "@yogaswap/shared": "file:../shared",
    "archiver": "^5.3.2",
    "aws-amplify": "^6.15.7",
    "aws-lambda": "^1.0.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.4.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.35.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  }
}
