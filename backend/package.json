{
  "name": "yogaswap-backend",
  "version": "1.0.0",
  "description": "Serverless backend für YogaSwap Demo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "seed": "ts-node src/seed/seed-swaps.ts",
