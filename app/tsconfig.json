{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "baseUrl": ".",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src", "../shared/src"],
  "references": [
    { "path": "../shared" }
  ]
}
