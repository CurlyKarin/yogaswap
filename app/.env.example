# YogaSwap – Umgebungsvariablen für lokale Entwicklung
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# Die Werte erhältst du nach dem Deployment mit: cd projects/yogaswap && tofu output
#
# Pro Umgebung (gitignored, fuer Builds via make deploy):
#   app/.env.staging  -> make deploy ENV=staging
#   app/.env.prod     -> make deploy ENV=prod
#   app/.env.production -> make deploy ENV=default (demo)

VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
